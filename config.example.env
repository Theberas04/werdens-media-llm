# Voorbeeldconfiguratie — Werdens Media LLM
# Kopieer naar config.env en pas aan. De systemd-dienst leest dit bestand.

# Waar alles staat
WLLM_HOME=/opt/werdens-media-llm
WLLM_MODELS=/opt/werdens-media-llm/models
WLLM_ENGINE=/opt/werdens-media-llm/engine/llama-b12262/llama-server

# Luisteren: 11434 is de Ollama-poort, zodat bestaande clients meteen werken
WLLM_HOST=0.0.0.0
WLLM_PORT=11434

# Rekenkracht
# Hermes eist minimaal 64000 tokens context; 65536 is de eerstvolgende macht van 2.
WLLM_CTX=65536
# 8-bits KV-cache halveert het geheugen (64k: ~1,1 GB in plaats van ~2,15 GB)
WLLM_KV_TYPE=q8_0
WLLM_THREADS=4

# Modellen warm houden (seconden) en daarna ontladen om geheugen vrij te geven
WLLM_KEEP_ALIVE=300

# Interne poort waarop de eerste engine start
WLLM_ENGINE_PORT=18500
